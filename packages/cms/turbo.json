{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "passThroughEnv": [
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy"
      ],
      "outputs": ["$TURBO_EXTENDS$", "src/generated/**"]
    },
    "lint": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    }
  }
}
